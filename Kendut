    </section>


    <!-- DECORATIVE WEB -->
    <div class="bottom-web">

      <div class="ring"></div>
      <div class="ring"></div>
      <div class="ring"></div>

      <div class="line"></div>
      <div class="line"></div>
      <div class="line"></div>
      <div class="line"></div>
      <div class="line"></div>
      <div class="line"></div>

    </div>


    <footer>
      made with chaos & love · <b>Abadam Parker</b>
    </footer>

  </main>


  <script>

    /* =========================
       RANDOM PARTICLES
    ========================= */

    const body = document.body;

    for (let i = 0; i < 18; i++) {

      const particle = document.createElement("div");

      particle.className = "particle";

      particle.style.left = Math.random() * 100 + "%";
      particle.style.animationDuration =
        (10 + Math.random() * 15) + "s";

      particle.style.animationDelay =
        Math.random() * 10 + "s";

      particle.style.opacity =
        (0.1 + Math.random() * 0.35);

      body.appendChild(particle);
    }


    /* =========================
       CLICK WEB EFFECT
    ========================= */

    document.addEventListener("click", function(e) {

      const web = document.createElement("div");

      web.style.position = "fixed";
      web.style.left = e.clientX + "px";
      web.style.top = e.clientY + "px";
      web.style.width = "10px";
      web.style.height = "10px";
      web.style.border = "1px solid rgba(255,255,255,.7)";
      web.style.borderRadius = "50%";
      web.style.transform = "translate(-50%, -50%)";
      web.style.pointerEvents = "none";
      web.style.zIndex = "9999";
      web.style.animation = "clickWeb .7s ease-out forwards";

      document.body.appendChild(web);

      setTimeout(() => {
        web.remove();
      }, 700);

    });


    const clickStyle = document.createElement("style");

    clickStyle.innerHTML = `
      @keyframes clickWeb {
        from {
          width: 10px;
          height: 10px;
          opacity: 1;
        }

        to {
          width: 100px;
          height: 100px;
          opacity: 0;
        }
      }
    `;

    document.head.appendChild(clickStyle);

  </script>

</body>
</html>
