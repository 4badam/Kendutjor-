  <div class="particle" style="left:47%; animation-duration:20s;"></div>
  <div class="particle" style="left:62%; animation-duration:15s;"></div>
  <div class="particle" style="left:78%; animation-duration:18s;"></div>
  <div class="particle" style="left:91%; animation-duration:13s;"></div>


  <main>

    <!-- HERO -->
    <section class="hero">

